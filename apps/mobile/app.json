{
  "expo": {
    "name": "Kova Health",
    "slug": "kova-health",
    "scheme": "kovahealth",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#161826",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#161826"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kovahealth.app"
    },
    "android": {
      "package": "com.kovahealth.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#161826",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      "react-native-health-connect",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kova usa tu ubicación para empezar las rutas en bici desde donde estás y para guiarte mientras andás, solo con la app abierta.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kova usa la cámara para leer códigos de barras y sacar fotos de tus comidas o etiquetas. Las fotos no se guardan.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kova usa la cámara para sacar fotos de tus comidas o etiquetas. Las fotos no se guardan.",
          "photosPermission": "Kova usa tus fotos solo si elegís una comida o una etiqueta de la galería."
        }
      ],
      "./plugins/withShortCxxDir",
      "./plugins/withReleaseSigning"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "url": "https://u.expo.dev/4d7a2ada-0465-4443-8a34-5dd4c26998b2"
    },
    "owner": "nickbarrios17",
    "extra": {
      "eas": {
        "projectId": "4d7a2ada-0465-4443-8a34-5dd4c26998b2"
      }
    }
  }
}
