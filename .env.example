# Copy to .env.local (gitignored). Values for local dev come from `supabase status`.
# Public: safe to ship in web/mobile/watch clients (RLS protects data).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Server-only. NEVER put this in a client bundle or commit it.
# Used only by integration tests (to create/clean fake users) and Edge Functions (injected by Supabase).
SUPABASE_SERVICE_ROLE_KEY=

# Local Mailpit (password-recovery tests).
MAILPIT_URL=http://127.0.0.1:54324
