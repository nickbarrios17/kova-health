{
  "$description": "Kova Health · Nocturno Vital · tokens finales. Formato W3C Design Tokens. Cada token lista su nombre actual por plataforma en $extensions.kova.names; los nombres existentes NO se renombran, los nuevos se agregan.",
  "color": {
    "bg": { "$type": "color", "$value": "#161826", "$description": "Fondo web y móvil", "$extensions": { "kova": { "names": { "css": "--color-bg", "rn": "c.bg", "kotlin": null } } } },
    "surface": { "$type": "color", "$value": "#232532", "$description": "Tarjetas, nivel 1", "$extensions": { "kova": { "names": { "css": "--color-surface", "rn": "c.surface", "kotlin": null } } } },
    "surface-raised": { "$type": "color", "$value": "#2C2F3F", "$description": "Hojas, menús, pistas, nivel 2 (nuevo)", "$extensions": { "kova": { "names": { "css": "--kova-surface-raised", "rn": "c.raised", "kotlin": null }, "new": true } } },
    "nav-bg": { "$type": "color", "$value": "#1C1E2C", "$description": "Barra lateral web y barra inferior móvil (nuevo)", "$extensions": { "kova": { "names": { "css": "--kova-nav-bg", "rn": "c.navBg", "kotlin": null }, "new": true } } },
    "watch-bg": { "$type": "color", "$value": "#000000", "$description": "Fondo Wear OS (OLED)", "$extensions": { "kova": { "names": { "css": null, "rn": null, "kotlin": "Bg" } } } },
    "watch-surface": { "$type": "color", "$value": "#292B31", "$description": "Controles secundarios Wear OS", "$extensions": { "kova": { "names": { "css": "--color-neutral-900", "rn": "c.n900", "kotlin": "Surface" } } } },
    "text": { "$type": "color", "$value": "#E9E9ED", "$description": "Texto principal. 14,5 / 12,6 / 10,9 : 1 sobre bg / surface / raised", "$extensions": { "kova": { "names": { "css": "--color-text", "rn": "c.text", "kotlin": "TextC" } } } },
    "text-2": { "$type": "color", "$value": "#B2B6CA", "$description": "Texto secundario. 8,8 / 7,6 / 6,6 : 1", "$extensions": { "kova": { "names": { "css": "--color-neutral-400", "rn": "c.n400", "kotlin": "N400" } } } },
    "text-3": { "$type": "color", "$value": "#9397AB", "$description": "Texto terciario, mínimo para texto. 6,1 / 5,3 / 4,6 : 1", "$extensions": { "kova": { "names": { "css": "--color-neutral-500", "rn": "c.n500", "kotlin": "N500" } } } },
    "text-disabled": { "$type": "color", "$value": "#75798C", "$description": "Solo controles deshabilitados (exento de contraste)", "$extensions": { "kova": { "names": { "css": "--color-neutral-600", "rn": "c.n600", "kotlin": null } } } },
    "accent": { "$type": "color", "$value": "#9184D9", "$description": "Trazos, progreso, selección, íconos activos. NUNCA texto sobre surface-raised (4,1:1)", "$extensions": { "kova": { "names": { "css": "--color-accent", "rn": "c.accent", "kotlin": "Accent" } } } },
    "accent-text": { "$type": "color", "$value": "#B5ABFC", "$description": "Todo texto violeta y anillo de foco. 8,6 / 7,4 / 6,4 : 1", "$extensions": { "kova": { "names": { "css": "--color-accent-400", "rn": "c.a400", "kotlin": "Accent400" }, "new_in": ["rn", "kotlin"] } } },
    "accent-strong": { "$type": "color", "$value": "#5D5294", "$description": "Relleno del botón primario y acción del reloj; texto blanco 6,8:1. NUNCA como color de texto", "$extensions": { "kova": { "names": { "css": "--color-accent-700", "rn": "c.a700", "kotlin": "Accent700" }, "new_in": ["kotlin"] } } },
    "accent-strong-hover": { "$type": "color", "$value": "#6B60A8", "$description": "Hover del primario; blanco 5,4:1 (nuevo)", "$extensions": { "kova": { "names": { "css": "--kova-accent-strong-hover", "rn": "c.a700Hover", "kotlin": null }, "new": true } } },
    "accent-strong-pressed": { "$type": "color", "$value": "#4E457E", "$description": "Presionado del primario (nuevo)", "$extensions": { "kova": { "names": { "css": "--kova-accent-strong-pressed", "rn": "c.a700Pressed", "kotlin": "Accent700Pressed" }, "new": true } } },
    "accent-soft": { "$type": "color", "$value": "#2A2843", "$description": "Fondo de insignias y chips seleccionados", "$extensions": { "kova": { "names": { "css": "--kova-accent-soft", "rn": "c.accentSoftSolid", "kotlin": null }, "new": true } } },
    "accent-soft-text": { "$type": "color", "$value": "#D2CEFD", "$description": "Texto sobre accent-soft, 9,4:1", "$extensions": { "kova": { "names": { "css": "--color-accent-300", "rn": "c.a300", "kotlin": "Accent300" } } } },
    "accent-track": { "$type": "color", "$value": "#3A3466", "$description": "Pista de anillos, descanso y rango habitual (nuevo)", "$extensions": { "kova": { "names": { "css": "--kova-accent-track", "rn": "c.track", "kotlin": "Track" }, "new": true } } },
    "ok": { "$type": "color", "$value": "#6FD6A3", "$description": "Cumplido. Siempre con ✓ y texto", "$extensions": { "kova": { "names": { "css": "--kova-ok", "rn": "c.ok", "kotlin": "Ok" }, "note": "kova.css lo define en oklch; pasar al hex" } } },
    "warn": { "$type": "color", "$value": "#EFC173", "$description": "Atención / pendiente. Siempre con △ o ↑ y texto", "$extensions": { "kova": { "names": { "css": "--kova-warn", "rn": "c.warn", "kotlin": "Warn" } } } },
    "crit": { "$type": "color", "$value": "#F08A78", "$description": "Error. Siempre con ✕, texto y acción", "$extensions": { "kova": { "names": { "css": "--kova-crit", "rn": "c.crit", "kotlin": "Crit" }, "new_in": ["kotlin"] } } },
    "ok-soft": { "$type": "color", "$value": "#1D3A2E", "$description": "Fondo de banner ok; ok encima 7,0:1", "$extensions": { "kova": { "names": { "css": "--kova-ok-soft", "rn": "c.okSoft", "kotlin": null }, "new": true } } },
    "warn-soft": { "$type": "color", "$value": "#3A3020", "$description": "Fondo de banner atención; warn encima 7,7:1", "$extensions": { "kova": { "names": { "css": "--kova-warn-soft", "rn": "c.warnSoft", "kotlin": null }, "new": true } } },
    "crit-soft": { "$type": "color", "$value": "#3D2522", "$description": "Fondo de banner error; crit encima 5,8:1", "$extensions": { "kova": { "names": { "css": "--kova-crit-soft", "rn": "c.critSoft", "kotlin": null }, "new": true } } },
    "chart-muted": { "$type": "color", "$value": "#6B6F84", "$description": "Barras inactivas, 3,1:1 sobre surface", "$extensions": { "kova": { "names": { "css": "--kova-chart-muted", "rn": "c.chartMuted", "kotlin": null }, "new": true } } },
    "chart-empty": { "$type": "color", "$value": "#3A3D4C", "$description": "Anillo punteado vacío y marcas sin dato", "$extensions": { "kova": { "names": { "css": "--kova-chart-empty", "rn": "c.chartEmpty", "kotlin": null }, "new": true } } },
    "skeleton": { "$type": "color", "$value": "#2C2F3F", "$description": "Esqueletos de carga" },
    "border-subtle": { "$type": "color", "$value": "rgba(233,233,237,0.08)", "$description": "Separadores" },
    "border": { "$type": "color", "$value": "rgba(233,233,237,0.16)", "$description": "Inputs y chips", "$extensions": { "kova": { "names": { "css": "--color-divider", "rn": "c.divider", "kotlin": "Divider" } } } },
    "border-strong": { "$type": "color", "$value": "rgba(233,233,237,0.24)", "$description": "Botón secundario" },
    "scrim": { "$type": "color", "$value": "rgba(10,11,18,0.70)", "$description": "Fondo detrás de hojas y diálogos" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
    "weight": { "regular": { "$type": "fontWeight", "$value": 400 }, "medium": { "$type": "fontWeight", "$value": 500 }, "semibold": { "$type": "fontWeight", "$value": 600 } },
    "numeric": { "$value": "tabular-nums", "$description": "Todas las cifras" }
  },
  "typography": {
    "display":     { "web": 44, "mobile": 36, "watch": 56, "weight": 600, "lineHeight": 1.0,  "tracking": "-0.025em" },
    "title-1":     { "web": 34, "mobile": 26, "watch": null, "weight": 600, "lineHeight": 1.15, "tracking": "-0.02em" },
    "metric":      { "web": 30, "mobile": 24, "watch": 48, "weight": 600, "lineHeight": 1.1,  "tracking": "-0.015em" },
    "title-2":     { "web": 20, "mobile": 17, "watch": 16, "weight": 600, "lineHeight": 1.2,  "tracking": "-0.01em" },
    "title-3":     { "web": 17, "mobile": 17, "watch": 15, "weight": 600, "lineHeight": 1.3,  "tracking": "0" },
    "body":        { "web": 15, "mobile": 15, "watch": 14, "weight": 400, "lineHeight": 1.55, "tracking": "0" },
    "body-strong": { "web": 15, "mobile": 15, "watch": 15, "weight": 500, "lineHeight": 1.45, "tracking": "0" },
    "label":       { "web": 13, "mobile": 13, "watch": 13, "weight": 500, "lineHeight": 1.4,  "tracking": "0" },
    "caption":     { "web": 12, "mobile": 12, "watch": 12, "weight": 400, "lineHeight": 1.4,  "tracking": "0" },
    "axis":        { "web": 11, "mobile": 11, "watch": null, "weight": 500, "lineHeight": 1.2, "tracking": "0.02em" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "$description": "px en web, dp en móvil y reloj. Reemplaza --space-* de 2,8 px (se conservan como alias)" },
  "radius": { "sm": 6, "md": 12, "md-web-control": 10, "lg": 16, "xl": 20, "2xl": 24, "pill": 999, "$description": "Los radios 4/8/14 actuales quedan como alias" },
  "size": {
    "touch-min-web": 40, "touch-critical-web": 44, "touch-min-mobile": 48, "primary-mobile": 52, "touch-min-watch": 48, "primary-watch": 52,
    "icon-web": 20, "icon-mobile": 22, "icon-watch": 24, "nav-web-expanded": 248, "nav-web-collapsed": 72, "tabbar-mobile": 80, "live-bar-mobile": 56
  },
  "elevation": {
    "0": "bg sin borde",
    "1": "surface sin borde ni sombra",
    "2": "surface-raised + border-subtle",
    "3": "surface-raised + border + 0 16px 40px rgba(0,0,0,0.45) (solo diálogos y avisos)"
  },
  "focus": { "width": 2, "offset": 3, "color": "{color.accent-text}" },
  "z": { "base": 0, "sticky": 10, "overlay": 40, "toast": 50 },
  "breakpoint": { "mobile-redirect": 768, "laptop": 1024, "desktop": 1280, "wide": 1440 },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320, "skeleton-cycle": 1200, "toast-visible": 3000 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "exit": "cubic-bezier(0.3, 0, 1, 1)" },
    "reduced": "Sin desplazamientos ni escalas; solo opacidad ≤ 120 ms; anillos y barras sin animar; 3D pausado"
  },
  "chart": {
    "series": "{color.accent}", "comparison": "{color.chart-muted}", "goal-line": { "color": "{color.text-3}", "width": 1.5, "dash": "4 6" },
    "range-band": "{color.accent-track}", "line-width": 3, "bar-radius-top": 6, "axis-size": 11, "grid": "rgba(233,233,237,0.06)"
  }
}
